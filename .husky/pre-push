set -e

# Enforce a linear PR history locally — the merge queue rejects branches that
# carry merge commits, and the CI `linear-history` job fails them at PR time.
# This mirrors that gate before the push leaves your machine. It reuses the
# same script CI runs: packages/dev-tools/tools/check-linear-history.sh.
#
# Scope: feature branches only. Never gate `main` (merge-queue owned) or the
# derived `no-comment` benchmark branch (rebuilt by no-comment-mirror.yml;
# its ancestry is not a PR rebase onto main).
#
# A pre-push hook (not pre-commit) is the right place: git skips pre-commit on
# merge commits, so a clean `git merge`/`git pull` would slip past it.
#
# stdin lines: <local ref> <local oid> <remote ref> <remote oid>
# Escape hatch: `git push --no-verify`.

DEFAULT_BRANCH="main"
DERIVED_BRANCH="no-comment"
export BASE_REF="origin/$DEFAULT_BRANCH"
if ! git rev-parse --verify --quiet "$BASE_REF" >/dev/null 2>&1; then
  # Fresh clone without an origin/main ref — fall back to the local branch.
  export BASE_REF="$DEFAULT_BRANCH"
fi

# Track whether we're pushing a feature branch. The lint gate and the
# linear-history check only run for those — pushes to main / no-comment are
# owned by the merge queue and the mirror workflow respectively.
pushing_feature=false
status=0
while read -r local_ref local_oid remote_ref remote_oid; do
  # Skip branch deletions (local oid is all zeros).
  case "$local_oid" in
    *[!0]*) ;;
    *) continue ;;
  esac
  # Only feature branch heads are gated. Match exact refs so names like
  # `feature/main` or `feature/no-comment` still get the checks.
  case "$remote_ref" in
    "refs/heads/$DEFAULT_BRANCH" | "refs/heads/$DERIVED_BRANCH") continue ;;
    refs/heads/*) pushing_feature=true ;;
    *) continue ;;
  esac
  pushed_oid="$local_oid"
  if ! bash packages/dev-tools/tools/check-linear-history.sh "$BASE_REF" "$local_oid"; then
    status=1
  fi
done

[ "$status" -ne 0 ] && exit "$status"

# ── Lint gate ────────────────────────────────────────────────────────────────
# Mirror the CI `lint` job locally so failures surface before the push, not
# after a red PR. Only runs for feature branches.
# Escape hatch: `git push --no-verify`.
if [ "$pushing_feature" = true ]; then
  # Ensure the working tree matches the pushed commit. Without this, the gate
  # could pass against uncommitted fixes while the pushed commit still has
  # lint failures, or fail due to unrelated uncommitted changes.
  head_oid="$(git rev-parse HEAD)"
  if [ "$pushed_oid" != "$head_oid" ]; then
    echo "pre-push: pushed OID ($pushed_oid) differs from HEAD ($head_oid)." >&2
    echo "Check out the branch you are pushing, or use git push --no-verify." >&2
    exit 1
  fi
  if ! git diff --quiet HEAD; then
    echo "pre-push: working tree has uncommitted changes." >&2
    echo "Commit or stash them so the lint gate checks what will actually be pushed." >&2
    exit 1
  fi

  bash packages/dev-tools/tools/pre-push-lint-gate.sh
fi

set -e

npx lint-staged

# On the no-comment benchmark branch, refuse comments and developer docs.
if [ -f .no-comment ]; then
  node packages/dev-tools/no-comment/check.mjs
fi

# Enforce instruction-file size budgets when a budgeted file is staged
# (root/agent CLAUDE.md or a GitHub Copilot instruction file).
# Runs once, after lint-staged formatting (race-free).
if git diff --cached --name-only | grep -qE '^(CLAUDE\.md|packages/vfs-root/shared/CLAUDE\.md|\.github/copilot-instructions\.md|\.github/instructions/.*\.instructions\.md|packages/.*/CLAUDE\.md)$'; then
  node packages/dev-tools/tools/check-doc-sizes.mjs
fi

# Layer-stack back-edge ratchet: when a gated package's source (or a baseline)
# is staged, fail on any NEW import pointing up that package's layer stack.
# Sub-second scan; the same gate runs in `npm run lint` / `lint:ci` and pre-push.
if git diff --cached --name-only | grep -qE '^(packages/(webapp|node-server|chrome-extension|cloudflare-worker)/src/|packages/dev-tools/tools/layer-back-edge-baseline)'; then
  node packages/dev-tools/tools/check-layer-back-edges.mjs
fi

# Record<string, unknown> ratchet: when any package source (or the baseline) is
# staged, fail on any NEW untyped string-keyed bag. Sub-second scan; the same
# gate runs in `npm run lint` / `lint:ci` and pre-push.
if git diff --cached --name-only | grep -qE '^(packages/.*\.(ts|tsx|js|mjs|cjs)|packages/dev-tools/tools/record-string-unknown-baseline\.json)$'; then
  node packages/dev-tools/tools/check-record-string-unknown.mjs
fi

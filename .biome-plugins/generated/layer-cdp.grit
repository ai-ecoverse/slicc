or {
    `import $_ from $source`,
    `export $_ from $source`,
    `import($source)`,
    `require($source)`
} where {
    $source <: r".*(?:\.\./)+(?:tools|core|scoops|ui)/.*",
    register_diagnostic(
        span = $source,
        message = "cdp/ must not import higher layers: tools/, core/, scoops/, ui/.",
        severity = "error"
    )
}

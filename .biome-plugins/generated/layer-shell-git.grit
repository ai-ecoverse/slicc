or {
    `import $_ from $source`,
    JsImportNamedClause(source = $source),
    `export $_ from $source`,
    `import($source)`,
    `require($source)`
} where {
    $source <: r".*(?:\.\./)+(?:cdp|tools|core|scoops|ui)/.*",
    register_diagnostic(
        span = $source,
        message = "shell/git/ must not import higher layers: cdp/, tools/, core/, scoops/, ui/.",
        severity = "error"
    )
}

{
  "name": "@slicc/webapp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "size": "size-limit",
    "test": "vitest run --root ../.. --config vitest.config.ts --project webapp",
    "typecheck": "tsc --noEmit -p ../../tsconfig.json"
  },
  "size-limit": [
    {
      "name": "webapp: main entry chunk",
      "path": "../../dist/ui/assets/main-*.js",
      "brotli": false,
      "limit": "24 kB"
    },
    {
      "name": "webapp: kernel worker",
      "path": "../../dist/ui/assets/kernel-worker-*.js",
      "brotli": false,
      "limit": "1910 kB"
    },
    {
      "name": "webapp: total JS payload",
      "path": "../../dist/ui/**/*.js",
      "brotli": false,
      "limit": "25 MB"
    }
  ],
  "dependencies": {
    "@adobe/helix-rum-js": "^2.14.2",
    "@ai-ecoverse/spoon": "*",
    "@cantoo/pdf-lib": "^2.6.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@earendil-works/pi-agent-core": "^0.84.0",
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@huggingface/transformers": "4.2.0",
    "@imagemagick/magick-wasm": "^0.0.42",
    "@lezer/highlight": "^1.2.3",
    "@pierre/diffs": "^1.1.15",
    "@slicc/cloud-core": "*",
    "@slicc/shared-ts": "*",
    "@slicc/webcomponents": "*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@zenfs/core": "2.6.2",
    "@zenfs/dom": "1.2.10",
    "buffer": "6.0.3",
    "croner": "^10.0.1",
    "esbuild-wasm": "0.28.2",
    "esptool-js": "^0.6.0",
    "fflate": "^0.8.2",
    "isomorphic-dompurify": "^3.1.0",
    "isomorphic-git": "1.41.4",
    "js-md5": "^0.9.0",
    "js-sha1": "^0.7.0",
    "js-sha256": "^1.0.0",
    "just-bash": "^3.4.1",
    "kokoro-js": "1.2.1",
    "lucide": "^1.8.0",
    "marked": "^18.0.0",
    "mri": "^1.2.0",
    "nanotar": "0.3.0",
    "openai": "^7.0.0",
    "pako": "^3.0.0",
    "semver": "7.8.5",
    "shiki": "3.23.0",
    "sql.js": "^1.14.0",
    "tst": "9.4.0",
    "unpdf": "^1.4.0",
    "xterm-readline": "1.2.2"
  },
  "devDependencies": {
    "@biomejs/js-api": "6.0.0",
    "@biomejs/wasm-web": "2.5.8",
    "@ffmpeg/core": "0.12.10",
    "@types/jsdom": "^30.0.0",
    "@types/semver": "7.8.0",
    "@types/w3c-web-serial": "^1.0.8",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^30.0.0",
    "puppeteer-core": "^25.0.0"
  }
}

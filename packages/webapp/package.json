{
  "name": "@slicc/webapp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "size": "size-limit && node ../dev-tools/tools/check-first-load-size.mjs",
    "test": "vitest run --root ../.. --config vitest.config.ts --project webapp",
    "typecheck": "tsc --noEmit -p ../../tsconfig.json"
  },
  "size-limit": [
    {
      "name": "webapp: total JS payload",
      "path": "../../dist/ui/**/*.js",
      "brotli": false,
      "limit": "25 MB"
    }
  ],

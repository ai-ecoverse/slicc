{
  "name": "@ai-ecoverse/cherry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./embed-ui": {
      "types": "./src/embed-ui.ts",
      "import": "./src/embed-ui.ts"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "html2canvas-pro": "2.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-preview-bootstrap.mjs",
    "test": "vitest run --root ../.. --config vitest.config.ts --project cherry",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "typescript": "7.0.2"
  }
}

{
  "name": "@ai-ecoverse/cherry",
  "version": "6.250.1",
  "description": "Cherry: embed a SLICC follower in a host web page and lend the page to a SLICC cone as a capability-limited browser target.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./embed-ui": {
      "types": "./dist/embed-ui.d.ts",
      "import": "./dist/embed-ui.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./preview-bridge.js": "./dist/preview-bridge.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc.git",
    "directory": "packages/cherry"
  },
  "homepage": "https://github.com/ai-ecoverse/slicc/tree/main/packages/cherry#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "html2canvas-pro": "2.5.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-preview-bootstrap.mjs",
    "test": "vitest run --root ../.. --config vitest.config.ts --project cherry",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "typescript": "7.0.2"
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- macOS app extensions must be sandboxed. The widget reads one file out
	     of the shared group and nothing else: no network, no user-selected
	     files, no Apple events. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>S8LB56P782.com.slicc.sliccstart.fileprovider</string>
	</array>
</dict>
</plist>

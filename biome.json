{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "plugins": ["./.biome-plugins/no-innerhtml-electron-overlay.grit"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.json",
      "**/*.jsonc",
      "**/*.css",
      "!**/dist/**",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!**/.vite/**",
      "!**/playwright-report/**",
      "!**/test-results/**",
      "!**/artifacts/**",
      "!**/.wrangler/**",
      "!**/.worktrees/**",
      "!**/.yolo/**",
      "!**/.qa/**",
      "!**/.build/**",
      "!**/package-lock.json",
      "!packages/assets/fonts/**",
      "!packages/swift-launcher/**",
      "!packages/swift-server/**",
      "!packages/ios-app/**",
      "!**/*.min.js",
      "!packages/webapp/src/ui/rum.js",
      "!packages/webapp/src/ui/lucide-icons.ts",
      "!packages/cloudflare-worker/src/preview-bridge-assets.ts",
      "!**/tests/fixtures/workflows/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "es5",
      "arrowParentheses": "always",
      "bracketSpacing": true
    },
    "globals": ["__DEV__"]
  },
  "json": {
    "formatter": {
      "enabled": true,
      "trailingCommas": "none"
    },
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 25
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 150,
            "skipIifes": true
          }
        },
        "noForEach": "off",
        "noBannedTypes": "off",
        "noUselessConstructor": "off",
        "noUselessSwitchCase": "off",
        "noStaticOnlyClass": "off",
        "noUselessFragments": "off",
        "useArrowFunction": "off",
        "useOptionalChain": "error",
        "useLiteralKeys": "off",
        "noImportantStyles": "error"
      },
      "correctness": {
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        },
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "off",
        "noUnusedPrivateClassMembers": "off",
        "useExhaustiveDependencies": "off",
        "noNodejsModules": "off",
        "noUndeclaredVariables": "off",
        "noConstantCondition": "error",
        "noInnerDeclarations": "off",
        "noConstAssign": "error",
        "noPrecisionLoss": "error",
        "noSwitchDeclarations": "off",
        "noUnreachable": "error"
      },
      "style": {
        "useNamingConvention": {
          "level": "warn",
          "options": {
            "strictCase": false,
            "requireAscii": true,
            "conventions": [
              {
                "selector": {
                  "kind": "function"
                },
                "match": "_*(.+?)_*",
                "formats": ["camelCase", "PascalCase"]
              },
              {
                "selector": {
                  "kind": "classMember"
                },
                "match": "_*(.+?)_*",
                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
              },
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "match": ".*"
              },
              {
                "selector": {
                  "kind": "typeProperty"
                },
                "match": ".*"
              },
              {
                "selector": {
                  "kind": "enumMember"
                },
                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
              },
              {
                "selector": {
                  "kind": "typeLike"
                },
                "formats": ["PascalCase"]
              },
              {
                "selector": {
                  "kind": "variable"
                },
                "match": "_*\\$?(.+?)_*",
                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
              }
            ]
          }
        },
        "useImportType": "error",
        "useExportType": "error",
        "useConst": "error",
        "useTemplate": "off",
        "useSingleVarDeclarator": "off",
        "useNumberNamespace": "off",
        "useEnumInitializers": "off",
        "useNodejsImportProtocol": "off",
        "useDefaultParameterLast": "off",
        "useExponentiationOperator": "off",
        "useLiteralEnumMembers": "off",
        "noUselessElse": "off",
        "noNonNullAssertion": "off",
        "noParameterAssign": "off",
        "noUnusedTemplateLiteral": "off",
        "noInferrableTypes": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noEmptyBlockStatements": "off",
        "noEmptyInterface": "off",
        "noConfusingVoidType": "off",
        "noAssignInExpressions": "off",
        "noConsole": "off",
        "noShadowRestrictedNames": "off",
        "noImplicitAnyLet": "off",
        "noPrototypeBuiltins": "off",
        "noGlobalIsNan": "off",
        "noControlCharactersInRegex": "off",
        "noSparseArray": "error",
        "noDoubleEquals": {
          "level": "error",
          "options": {
            "ignoreNull": true
          }
        },
        "noDebugger": "error",
        "noDuplicateCase": "error",
        "noIrregularWhitespace": "error",
        "noFunctionAssign": "error",
        "noArrayIndexKey": "off",
        "noEvolvingTypes": "off",
        "noAsyncPromiseExecutor": "error",
        "noThenProperty": "off",
        "noCatchAssign": "off",
        "noFallthroughSwitchClause": "off",
        "noTemplateCurlyInString": "off",
        "useIterableCallbackReturn": "error"
      },
      "performance": {
        "noDelete": "off",
        "noAccumulatingSpread": "off"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      },
      "a11y": {
        "preset": "none"
      },
      "security": {
        "preset": "recommended"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.mjs", "**/test-*.mjs"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noConstructorReturn": "off",
            "noUnsafeOptionalChaining": "off"
          },
          "style": {
            "useNamingConvention": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/webapp/providers/**/*.ts",
        "packages/webapp/src/types/**/*.ts",
        "packages/webapp/src/stubs/**/*.ts",
        "packages/webapp/src/globals.d.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.json", "**/*.jsonc", "**/tsconfig*.json", "**/.releaserc.json"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "packages/webapp/cloud/app.js",
        "packages/webapp/src/shell/supplemental-commands/websocat-command.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/cherry/src/cdp-host-handlers.ts",
        "packages/chrome-extension/src/secrets-entry.ts",
        "packages/cloud-core/src/operations/start.ts",
        "packages/webapp/src/kernel/realm/http-global.ts",
        "packages/webapp/src/kernel/realm/ws-router-page.ts",
        "packages/webapp/src/net/link-header.ts",
        "packages/webapp/src/shell/supplemental-commands/websocat-command.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/chrome-extension/capture-popup.js",
        "packages/chrome-extension/src/secrets-entry.ts",
        "packages/webapp/cloud/app.js",
        "packages/webapp/providers/adobe.ts",
        "packages/webapp/providers/cerebras.ts",
        "packages/webapp/providers/openai-codex.ts",
        "packages/webapp/providers/xai-grok.ts",
        "packages/webapp/src/cdp/har-recorder.ts",
        "packages/webapp/src/providers/built-in/bedrock-camp.ts",
        "packages/webapp/src/providers/intercepted-oauth.ts",
        "packages/webapp/src/shell/supplemental-commands/playwright/teleport.ts",
        "packages/webapp/tests/cdp/cdp-client.test.ts",
        "packages/webapp/tests/kernel/realm/realm-runner.test.ts",
        "packages/webapp/tests/shell/di/di.test.ts",
        "packages/webapp/tests/ui/provider-settings.test.ts"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "noFloatingPromises": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/webapp/providers/adobe.ts",
        "packages/webapp/src/kernel/cdp-worker-proxy.ts",
        "packages/webapp/src/shell/supplemental-commands/playwright/handlers/routing.ts",
        "packages/webapp/tests/providers/adobe-provider.test.ts"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "noMisusedPromises": "off"
          }
        }
      }
    }
  ]
}

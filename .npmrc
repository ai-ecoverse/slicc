legacy-peer-deps=true

# kokoro-js nests onnxruntime-node@1.21.0, whose postinstall probes for CUDA and
# tries to fetch onnxruntime-linux-x64-gpu-1.21.0.tgz. That asset 404s on the
# Microsoft release (CI saw it on every Linux npm ci after 2026-11-17 ~23:00Z).
# CPU ORT still installs; we do not need the CUDA EP in CI or local builds.
onnxruntime-node-install-cuda=skip

# Harden `npm ci` against registry network transients (ETIMEDOUT /
# ECONNRESET / 429 / 503) that flake CI on attempt 1 but pass on re-run.
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=2000
fetch-retry-maxtimeout=120000
fetch-timeout=300000

# The audit POST is the last thing `npm ci` does, and the audit summary is the
# last line printed before every observed hang-on-exit — a keep-alive socket
# left in the agent pool is the prime suspect for the handle that keeps the
# process alive. Skipping it removes the suspect and shaves a round-trip off
# every install. `npm audit` still works on demand, and Dependabot is the
# actual vulnerability gate.
audit=false
fund=false

